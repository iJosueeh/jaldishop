                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"merchant.demo@jaldishop.com\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"Carlos\",\n  \"lastName\": \"García\",\n  \"phone\": \"+51987654321\",\n  \"storeName\": \"Pastelería Dulce Deleite\",\n  \"businessType\": \"BAKERY\",\n  \"storeContactPhone\": \"+51987654321\",\n  \"address\": \"Av. La Marina 1234, San Miguel\",\n  \"pickupEnabled\": true,\n  \"deliveryEnabled\": true\n}"
