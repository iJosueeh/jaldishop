        {
          "name": "03. Login Merchant -> Guarda Token Automático",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('merchantToken', jsonData.token);",
                  "    pm.environment.set('merchantToken', jsonData.token);",
                  "    console.log('merchantToken guardado exitosamente');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"merchant.demo@jaldishop.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Autenticación para obtener JWT del Comerciante. El token se guarda automáticamente en la variable {{merchantToken}}."
          }
        },
        {
          "name": "04. Login Customer -> Guarda Token Automático",
