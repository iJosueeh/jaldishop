# Base nueva y exclusiva de desarrollo. Debe existir antes de iniciar Spring Boot.
DB_URL=jdbc:postgresql://127.0.0.1:5433/jaldishop_dev
DB_USERNAME=jaldishop
DB_PASSWORD=solo_desarrollo_local
PORT=8080
SERVER_ADDRESS=127.0.0.1

JWT_SECRET=local-development-only-change-this-key-before-sharing-any-tokens-2026

# Flyway aplica las migraciones y valida sus checksums; no usar repair para ocultar errores.
FLYWAY_VALIDATE_ON_MIGRATE=true

# Sin integración externa: URL loopback y credenciales vacías admitidas al iniciar.
# El cliente rechaza pagos/consultas/reembolsos sin access token antes de enviar HTTP.
MERCADOPAGO_BASE_URL=http://127.0.0.1:9
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CHECKOUT_MODE=ORDERS
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_BACK_URL_SUCCESS=
MERCADOPAGO_BACK_URL_FAILURE=
MERCADOPAGO_BACK_URL_PENDING=

# No ejecutar conciliación ni reembolsos automáticos en desarrollo local.
APP_PAYMENT_RECONCILIATION_ENABLED=false
APP_PAYMENT_RECONCILIATION_ORDERS_ENABLED=false
PAYMENTS_MERCADOPAGO_REFUND_SCHEDULER_ENABLED=false

# Valores de ejemplo válidos para construir el bean; no habilitan subida/borrado de imágenes.
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo
CLOUDINARY_API_SECRET=demo
