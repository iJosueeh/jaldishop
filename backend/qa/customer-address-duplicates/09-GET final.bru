meta {
  name: GET final
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/customer/addresses
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Dos direcciones y una predeterminada", function () {
    const body = res.getBody();
    expect(body.total).to.equal(2);
    expect(body.maxAllowed).to.equal(5);
    expect(body.addresses.filter(a => a.isDefault)).to.have.lengthOf(1);
    expect(new Set(body.addresses.map(a => a.ubigeoCode + "|" + a.streetAddress.trim().replace(/\s+/g, " ").toLowerCase())).size).to.equal(2);
  });
}
