meta {
  name: Panaderia mayusculas
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/stores/search?q=PANADER%C3%8DA&limit=5
  body: none
  auth: none
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Coincidencias exactas; estados ocultos excluidos", function () {
    expect(res.getBody().map(s => s.slug).sort()).to.deep.equal(["horno-sur", "pan-del-norte"]);
  });
}
