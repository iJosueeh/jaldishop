meta {
  name: 03. Actualizar Configuración
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/capacity-configurations/{{capacityConfigId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "dayOfWeek": 1,
  "startTime": "09:00:00",
  "endTime": "14:00:00",
  "maxCapacity": 20
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
