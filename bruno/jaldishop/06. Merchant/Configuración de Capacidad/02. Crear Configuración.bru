meta {
  name: 02. Crear Configuración
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/capacity-configurations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "dayOfWeek": 1,
  "startTime": "09:00:00",
  "endTime": "13:00:00",
  "maxCapacity": 15
}
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    if (data && data.id) bru.setEnvVar("capacityConfigId", String(data.id));
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
