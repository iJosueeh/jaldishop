meta {
  name: 05. Actualizar Umbral de Stock Bajo
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/inventory/variants/{{variantId}}/threshold
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "lowStockThreshold": 8
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
