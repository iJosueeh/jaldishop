meta {
  name: 01. Listar Categorías de la Tienda
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/categories
  body: none
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

script:post-response {
  if (res.getStatus() === 201 || res.getStatus() === 200) {
    const data = res.getBody();
    const item = Array.isArray(data) ? data[0] : data;
    if (item && item.id) bru.setEnvVar("categoryId", String(item.id));
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
