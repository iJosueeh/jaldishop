meta {
  name: 06. Crear Producto en Tienda
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "categoryId": "{{categoryId}}",
  "name": "Torta Tres Leches",
  "slug": "tres-leches",
  "description": "Deliciosa torta",
  "imageUrl": "{{fixtureImageUrl}}"
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

script:post-response {
  if (res.getStatus() === 201 || res.getStatus() === 200) {
    const data = res.getBody();
    const item = Array.isArray(data) ? data[0] : data;
    if (item && item.id) bru.setEnvVar("productId", String(item.id));
    if (item && item.variants && item.variants.length > 0 && item.variants[0].id) {
      bru.setEnvVar("variantId", String(item.variants[0].id));
    }
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
