meta {
  name: 02. Actualizar Mi Tienda
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/stores/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "name": "Pastelería Delicia Actualizada",
  "description": "Tortas, postres y bocaditos",
  "contactPhone": "987654321",
  "address": "{{fixtureAddress}}",
  "addressReference": "{{fixtureAddressReference}}",
  "latitude": 0.0,
  "longitude": 0.0,
  "pickupEnabled": true,
  "deliveryEnabled": true,
  "deliveryFeeAmount": 6.0,
  "deliveryFeeCurrency": "PEN",
  "taxRate": 18.0,
  "logoUrl": null,
  "bannerUrl": null,
  "instagramUrl": null,
  "facebookUrl": null,
  "whatsappNumber": null,
  "categoryIds": []
}
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    const data = res.getBody();
    if (data && data.id) bru.setEnvVar("storeId", String(data.id));
    if (data && data.slug) bru.setEnvVar("storeSlug", String(data.slug));
    if (data && data.merchantUserId) bru.setEnvVar("merchantUserId", String(data.merchantUserId));
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
