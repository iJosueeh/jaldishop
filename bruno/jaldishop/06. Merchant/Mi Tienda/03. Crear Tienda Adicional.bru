meta {
  name: 03. Crear Tienda Adicional
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/stores
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "name": "Pastelería Delicia",
  "slug": "pasteleria-delicia",
  "description": "Tortas y bocaditos",
  "contactPhone": "987654321",
  "address": "{{fixtureAddress}}",
  "addressReference": "{{fixtureAddressReference}}",
  "latitude": 0.0,
  "longitude": 0.0,
  "pickupEnabled": true,
  "deliveryEnabled": true,
  "deliveryFeeAmount": 5.0,
  "deliveryFeeCurrency": "PEN",
  "taxRate": 18.0,
  "logoUrl": null,
  "bannerUrl": null,
  "instagramUrl": null,
  "facebookUrl": null,
  "whatsappNumber": null,
  "categoryIds": []
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    const data = res.getBody();
    if (data && data.id) bru.setEnvVar("storeId", String(data.id));
    if (data && data.slug) bru.setEnvVar("storeSlug", String(data.slug));
    if (data && data.merchantUserId) bru.setEnvVar("merchantUserId", String(data.merchantUserId));
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
