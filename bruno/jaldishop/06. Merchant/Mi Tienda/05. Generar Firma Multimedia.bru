meta {
  name: 05. Generar Firma Multimedia
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/media/upload-signature
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "targetType": "PRODUCT_IMAGE",
  "storeId": "{{storeId}}"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
