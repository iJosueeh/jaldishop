meta {
  name: 02. Consultar Disponibilidad de Capacidad
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/capacity/availability?storeId={{storeId}}&date={{serviceDate}}&startTime={{startTime}}&endTime={{endTime}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
