meta {
  name: 01. Consultar Franjas Horarias (Slots)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/capacity/slots?storeId={{storeId}}&date={{serviceDate}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
