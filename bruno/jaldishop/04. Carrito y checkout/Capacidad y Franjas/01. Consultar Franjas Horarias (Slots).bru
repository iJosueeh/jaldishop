meta {
  name: 01. Consultar Franjas Horarias (Slots)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/capacity/slots?storeId={{storeId}}&date={{serviceDate}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
