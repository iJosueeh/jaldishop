meta {
  name: 02. Agregar Ítem al Carrito
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/cart/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "storeId": "{{storeId}}",
  "variantId": "{{variantId}}",
  "quantity": 2
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
