meta {
  name: 03. Actualizar Cantidad de Ítem
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/cart/items/{{variantId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "storeId": "{{storeId}}",
  "quantity": 3
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
