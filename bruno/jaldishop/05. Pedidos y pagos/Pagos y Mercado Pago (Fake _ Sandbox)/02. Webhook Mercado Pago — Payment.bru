meta {
  name: 02. Webhook Mercado Pago — Payment
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/checkout/mercado-pago/webhook?data.id={{providerPaymentId}}&type=payment
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  x-signature: {{webhookSignature}}
  x-request-id: {{webhookRequestId}}
}

body:json {
{
  "action": "payment.updated",
  "api_version": "v1",
  "data": {
    "id": "{{providerPaymentId}}"
  },
  "date_created": "2026-11-04T12:00:00Z",
  "id": "{{providerPaymentId}}",
  "live_mode": false,
  "type": "payment",
  "user_id": "{{providerUserId}}"
}
}

script:pre-request {
  if (bru.getEnvVar("financialFakeReady") !== "true") {
    throw new Error("BLOQUEADO: Operación de pago requiere financialFakeReady=true con gateway fake local verificado.");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
