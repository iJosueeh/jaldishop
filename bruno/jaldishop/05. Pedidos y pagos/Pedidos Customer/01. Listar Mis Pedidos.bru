meta {
  name: 01. Listar Mis Pedidos
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/customer/orders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody();
    const items = Array.isArray(data) ? data : (data && data.content ? data.content : []);
    if (items.length > 0) {
      if (items[0].id) bru.setEnvVar("orderId", String(items[0].id));
      if (items[0].orderNumber) bru.setEnvVar("orderNumber", String(items[0].orderNumber));
    }
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
