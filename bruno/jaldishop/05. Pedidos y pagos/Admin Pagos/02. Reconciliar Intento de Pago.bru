meta {
  name: 02. Reconciliar Intento de Pago
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/payments/attempts/{{attemptId}}/reconcile-order
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
