meta {
  name: 03. Actualizar Roles de Usuario
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/admin/users/{{userId}}/roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "roles": [
    "CUSTOMER",
    "MERCHANT"
  ]
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
