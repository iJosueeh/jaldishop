meta {
  name: 02. Crear Dirección
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/customer/addresses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "alias": "Casa",
  "recipientName": "{{fixtureRecipientName}}",
  "recipientPhone": "{{fixtureRecipientPhone}}",
  "streetAddress": "{{fixtureStreetAddress}}",
  "department": "Lima",
  "province": "Lima",
  "district": "Miraflores",
  "ubigeoCode": "150122",
  "reference": "{{fixtureReference}}",
  "latitude": 0.0,
  "longitude": 0.0,
  "isDefault": true
}
}

script:post-response {
  if (res.getStatus() === 201 || res.getStatus() === 200) {
    const data = res.getBody();
    const item = Array.isArray(data) ? data[0] : data;
    if (item && item.id) bru.setEnvVar("addressId", String(item.id));
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
