meta {
  name: 01. Verificar Elegibilidad para Reseña
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/customer/products/{{productId}}/reviews/eligibility
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
