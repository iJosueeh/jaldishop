meta {
  name: 03. Consultar Estado de Favorito
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/customer/favorites/products/{{productId}}/status
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
