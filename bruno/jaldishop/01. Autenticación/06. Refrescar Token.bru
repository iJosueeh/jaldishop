meta {
  name: 06. Refrescar Token
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody();
    if (data && data.token) {
      bru.setEnvVar("authToken", data.token);
      bru.setEnvVar("customerToken", data.token);
      bru.setEnvVar("merchantToken", data.token);
      bru.setEnvVar("adminToken", data.token);
    }
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
