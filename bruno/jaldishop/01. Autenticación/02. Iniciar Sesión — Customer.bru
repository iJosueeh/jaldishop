meta {
  name: 02. Iniciar Sesión — Customer
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "email": "{{customerEmail}}",
  "password": "{{customerPassword}}"
}
}

script:pre-request {
  bru.setEnvVar("customerToken", "");
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody();
    if (data && data.token) bru.setEnvVar("customerToken", data.token);
    if (data && data.userId) bru.setEnvVar("customerUserId", String(data.userId));
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
