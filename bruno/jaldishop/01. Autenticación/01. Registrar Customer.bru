meta {
  name: 01. Registrar Customer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "email": "{{newRegistrationEmail}}",
  "password": "{{fixturePassword}}",
  "firstName": "{{fixtureFirstName}}",
  "lastName": "{{fixtureLastName}}",
  "phone": "{{fixturePhone}}"
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
  bru.setEnvVar("customerToken", "");
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    if (data && data.id) bru.setEnvVar("customerUserId", String(data.id));
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
