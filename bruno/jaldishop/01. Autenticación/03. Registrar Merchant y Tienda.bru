meta {
  name: 03. Registrar Merchant y Tienda
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/register/merchant
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "email": "{{newRegistrationEmail}}",
  "password": "{{fixturePassword}}",
  "firstName": "{{fixtureFirstName}}",
  "lastName": "{{fixtureLastName}}",
  "phone": "{{fixturePhone}}",
  "storeName": "Panadería Don Marco",
  "businessType": "BAKERY",
  "storeContactPhone": "987654322",
  "address": "{{fixtureAddress}}",
  "addressReference": "{{fixtureAddressReference}}",
  "latitude": 0.0,
  "longitude": 0.0,
  "pickupEnabled": true,
  "deliveryEnabled": true,
  "logoUrl": null,
  "bannerUrl": null,
  "categoryIds": []
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
  bru.setEnvVar("merchantToken", "");
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    if (data && data.token) bru.setEnvVar("merchantToken", data.token);
    if (data && data.userId) bru.setEnvVar("merchantUserId", String(data.userId));
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
