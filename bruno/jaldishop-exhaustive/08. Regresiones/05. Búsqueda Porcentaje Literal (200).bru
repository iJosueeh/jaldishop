meta {
  name: 05. Búsqueda Porcentaje Literal (200)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/stores/search?q=%25&limit=50
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
  test("Resultados no vacíos", function() { expect(res.getBody()).to.be.an("array").that.is.not.empty; });
}
