meta {
  name: 10. Método PATCH no Soportado Conserva Allow (405)
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/customer/addresses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "alias": "Casa",
  "recipientName": "{{fixtureRecipientName}}",
  "recipientPhone": "{{fixtureRecipientPhone}}",
  "streetAddress": "{{fixtureStreetAddress}}",
  "department": "Lima",
  "province": "Lima",
  "district": "Miraflores",
  "ubigeoCode": "150122",
  "reference": "{{fixtureReference}}",
  "latitude": 0.0,
  "longitude": 0.0,
  "isDefault": true
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
  test("Código METHOD_NOT_ALLOWED", function() { expect(res.getBody().code).to.equal("METHOD_NOT_ALLOWED"); });
  test("Cabecera Allow presente", function() { expect(res.getHeaders()["allow"] || res.getHeaders()["Allow"]).to.include("GET"); });
}
