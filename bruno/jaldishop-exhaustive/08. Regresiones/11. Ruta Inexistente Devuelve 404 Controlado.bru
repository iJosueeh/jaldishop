meta {
  name: 11. Ruta Inexistente Devuelve 404 Controlado
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/customer/addresses/{{addressId}}/missing
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
  test("Código RESOURCE_NOT_FOUND", function() { expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND"); });
}
