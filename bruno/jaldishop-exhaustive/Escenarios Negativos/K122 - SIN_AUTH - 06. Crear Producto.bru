meta {
  name: K122 - SIN_AUTH - 06. Crear Producto
  type: http
  seq: 158
}

post {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/products
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "categoryId": "{{categoryId}}",
  "name": "Torta Tres Leches",
  "slug": "tres-leches",
  "description": "Deliciosa torta",
  "imageUrl": "{{fixtureImageUrl}}"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
