meta {
  name: M212 - EXCEDE_comment - 04. Actualizar Reseña de Producto
  type: http
  seq: 465
}

put {
  url: {{baseUrl}}/api/v1/customer/products/{{productId}}/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "rating": 4,
  "comment": ""
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
