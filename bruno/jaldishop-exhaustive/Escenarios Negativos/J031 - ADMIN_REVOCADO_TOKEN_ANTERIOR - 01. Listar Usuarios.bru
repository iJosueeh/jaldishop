meta {
  name: J031 - ADMIN_REVOCADO_TOKEN_ANTERIOR - 01. Listar Usuarios
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/api/v1/admin/users?query=&role=&status=ACTIVE
  body: none
  auth: bearer
}

auth:bearer {
  token: {{revokedAdminToken}}
}

headers {
  Accept: application/json
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
