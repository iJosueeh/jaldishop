meta {
  name: J031 - ADMIN_REVOCADO_TOKEN_ANTERIOR - 01. Listar Usuarios
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/api/v1/admin/users?query=&role=&status=ACTIVE
  body: none
  auth: bearer
}

auth:bearer {
  token: {{revokedAdminToken}}
}

headers {
  Accept: application/json
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
