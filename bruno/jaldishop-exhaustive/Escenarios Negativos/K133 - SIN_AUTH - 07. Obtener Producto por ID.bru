meta {
  name: K133 - SIN_AUTH - 07. Obtener Producto por ID
  type: http
  seq: 168
}

get {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/products/{{productId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
