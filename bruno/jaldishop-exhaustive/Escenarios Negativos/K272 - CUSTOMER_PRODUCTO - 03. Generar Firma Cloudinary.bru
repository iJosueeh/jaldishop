meta {
  name: K272 - CUSTOMER_PRODUCTO - 03. Generar Firma Cloudinary
  type: http
  seq: 284
}

post {
  url: {{baseUrl}}/api/v1/media/upload-signature
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "targetType": "PRODUCT_IMAGE",
  "storeId": "{{storeId}}"
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
