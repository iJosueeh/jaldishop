meta {
  name: K220 - SIN_AUTH - 03. Ajustar Stock Físico (PUT)
  type: http
  seq: 247
}

put {
  url: {{baseUrl}}/api/v1/inventory/variants/{{variantId}}/stock
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "quantity": 25
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
