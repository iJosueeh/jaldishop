meta {
  name: K229 - UUID_INVALIDO_variantId - 04. Actualizar Umbral de Stock Bajo (PATCH)
  type: http
  seq: 255
}

patch {
  url: {{baseUrl}}/api/v1/inventory/variants/invalid-uuid/threshold
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "lowStockThreshold": 8
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
