meta {
  name: K229 - UUID_INVALIDO_variantId - 04. Actualizar Umbral de Stock Bajo (PATCH)
  type: http
  seq: 255
}

patch {
  url: {{baseUrl}}/api/v1/inventory/variants/invalid-uuid/threshold
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "lowStockThreshold": 8
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
