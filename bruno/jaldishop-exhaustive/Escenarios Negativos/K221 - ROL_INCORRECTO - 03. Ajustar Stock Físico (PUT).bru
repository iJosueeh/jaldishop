meta {
  name: K221 - ROL_INCORRECTO - 03. Ajustar Stock Físico (PUT)
  type: http
  seq: 248
}

put {
  url: {{baseUrl}}/api/v1/inventory/variants/{{variantId}}/stock
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "quantity": 25
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
