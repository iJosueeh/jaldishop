meta {
  name: K131 - EXCEDE_slug - 06. Crear Producto
  type: http
  seq: 167
}

post {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "categoryId": "{{categoryId}}",
  "name": "Torta Tres Leches",
  "slug": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
  "description": "Deliciosa torta",
  "imageUrl": "{{fixtureImageUrl}}"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
