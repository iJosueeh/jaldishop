meta {
  name: J037 - SIN_AUTH - 03. Actualizar Roles
  type: http
  seq: 31
}

patch {
  url: {{baseUrl}}/api/v1/admin/users/{{userId}}/roles
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "roles": [
    "CUSTOMER",
    "MERCHANT"
  ]
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
