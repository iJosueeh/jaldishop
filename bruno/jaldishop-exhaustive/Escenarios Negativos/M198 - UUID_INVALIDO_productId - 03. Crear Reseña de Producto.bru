meta {
  name: M198 - UUID_INVALIDO_productId - 03. Crear Reseña de Producto
  type: http
  seq: 452
}

post {
  url: {{baseUrl}}/api/v1/customer/products/invalid-uuid/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "rating": 5,
  "comment": "Excelente producto, 100% recomendado"
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
