meta {
  name: M198 - UUID_INVALIDO_productId - 03. Crear Reseña de Producto
  type: http
  seq: 452
}

post {
  url: {{baseUrl}}/api/v1/customer/products/invalid-uuid/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "rating": 5,
  "comment": "Excelente producto, 100% recomendado"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
