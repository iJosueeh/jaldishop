meta {
  name: K097 - ROL_INCORRECTO - 02. Crear Categoría
  type: http
  seq: 137
}

post {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "name": "Postres",
  "description": "Postres artesanales"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
