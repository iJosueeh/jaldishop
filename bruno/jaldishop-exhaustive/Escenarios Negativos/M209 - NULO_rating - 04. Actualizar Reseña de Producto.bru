meta {
  name: M209 - NULO_rating - 04. Actualizar Reseña de Producto
  type: http
  seq: 462
}

put {
  url: {{baseUrl}}/api/v1/customer/products/{{productId}}/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "rating": null,
  "comment": "Muy bueno pero tardó un poco"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
