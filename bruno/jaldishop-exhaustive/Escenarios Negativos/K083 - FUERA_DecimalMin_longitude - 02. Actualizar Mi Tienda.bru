meta {
  name: K083 - FUERA_DecimalMin_longitude - 02. Actualizar Mi Tienda
  type: http
  seq: 126
}

put {
  url: {{baseUrl}}/api/v1/stores/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "name": "Pastelería Delicia Actualizada",
  "description": "Tortas, postres y bocaditos",
  "contactPhone": "987654321",
  "address": "{{fixtureAddress}}",
  "addressReference": "{{fixtureAddressReference}}",
  "latitude": 0.0,
  "longitude": -181.0,
  "pickupEnabled": true,
  "deliveryEnabled": true,
  "deliveryFeeAmount": 6.0,
  "deliveryFeeCurrency": "PEN",
  "taxRate": 18.0,
  "logoUrl": null,
  "bannerUrl": null,
  "instagramUrl": null,
  "facebookUrl": null,
  "whatsappNumber": null,
  "categoryIds": []
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
