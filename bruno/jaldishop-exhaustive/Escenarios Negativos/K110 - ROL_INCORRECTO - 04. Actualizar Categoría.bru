meta {
  name: K110 - ROL_INCORRECTO - 04. Actualizar Categoría
  type: http
  seq: 148
}

put {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/categories/{{categoryId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "name": "Postres y Dulces",
  "description": "Nueva descripción",
  "status": "ACTIVE"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
