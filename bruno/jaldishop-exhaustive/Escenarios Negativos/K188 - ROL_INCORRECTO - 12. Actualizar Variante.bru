meta {
  name: K188 - ROL_INCORRECTO - 12. Actualizar Variante
  type: http
  seq: 218
}

put {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/products/{{productId}}/variants/{{variantId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "presentationName": "Porción Individual Grande",
  "sku": "CHEESE-IND-01",
  "priceAmount": 20.0,
  "priceCurrency": "PEN",
  "tracksInventory": true,
  "status": "ACTIVE",
  "attributes": []
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
