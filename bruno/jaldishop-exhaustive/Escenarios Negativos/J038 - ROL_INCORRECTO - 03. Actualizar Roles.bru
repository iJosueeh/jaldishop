meta {
  name: J038 - ROL_INCORRECTO - 03. Actualizar Roles
  type: http
  seq: 32
}

patch {
  url: {{baseUrl}}/api/v1/admin/users/{{userId}}/roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "roles": [
    "CUSTOMER",
    "MERCHANT"
  ]
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
