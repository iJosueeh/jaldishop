meta {
  name: K254 - SIN_AUTH - 08. Actualizar Excepción
  type: http
  seq: 271
}

put {
  url: {{baseUrl}}/api/v1/capacity-exceptions/{{capacityExceptionId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "serviceDate": "{{serviceDate}}",
  "startTime": "{{startTime}}",
  "endTime": "{{endTime}}",
  "exceptionCapacity": 0,
  "reason": "Cerrado por Navidad"
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
