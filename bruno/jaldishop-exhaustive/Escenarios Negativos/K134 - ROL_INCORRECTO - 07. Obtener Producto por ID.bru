meta {
  name: K134 - ROL_INCORRECTO - 07. Obtener Producto por ID
  type: http
  seq: 169
}

get {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/products/{{productId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
