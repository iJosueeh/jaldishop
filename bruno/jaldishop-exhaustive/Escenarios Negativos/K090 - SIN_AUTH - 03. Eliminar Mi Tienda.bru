meta {
  name: K090 - SIN_AUTH - 03. Eliminar Mi Tienda
  type: http
  seq: 132
}

delete {
  url: {{baseUrl}}/api/v1/stores/me
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "reason": "Cierre solicitado por el comerciante."
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
