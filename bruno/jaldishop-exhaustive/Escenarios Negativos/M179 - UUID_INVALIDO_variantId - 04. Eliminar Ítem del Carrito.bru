meta {
  name: M179 - UUID_INVALIDO_variantId - 04. Eliminar Ítem del Carrito
  type: http
  seq: 440
}

delete {
  url: {{baseUrl}}/api/v1/cart/items/invalid-uuid
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
