meta {
  name: M031 - AUSENTE_firstName - 07. Actualizar Mi Perfil
  type: http
  seq: 311
}

put {
  url: {{baseUrl}}/api/v1/users/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "lastName": "{{fixtureLastName}}",
  "phone": "{{fixturePhone}}"
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
