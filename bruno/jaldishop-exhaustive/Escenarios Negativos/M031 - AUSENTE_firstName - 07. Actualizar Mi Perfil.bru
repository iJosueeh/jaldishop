meta {
  name: M031 - AUSENTE_firstName - 07. Actualizar Mi Perfil
  type: http
  seq: 311
}

put {
  url: {{baseUrl}}/api/v1/users/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "lastName": "{{fixtureLastName}}",
  "phone": "{{fixturePhone}}"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
