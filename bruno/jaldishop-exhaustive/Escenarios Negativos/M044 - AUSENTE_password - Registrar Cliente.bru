meta {
  name: M044 - AUSENTE_password - Registrar Cliente
  type: http
  seq: 323
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "email": "{{newRegistrationEmail}}",
  "firstName": "{{fixtureFirstName}}",
  "lastName": "{{fixtureLastName}}",
  "phone": "{{fixturePhone}}"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
