meta {
  name: M219 - ROL_INCORRECTO - 01. Listar Pedidos de Tienda
  type: http
  seq: 470
}

get {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/orders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
