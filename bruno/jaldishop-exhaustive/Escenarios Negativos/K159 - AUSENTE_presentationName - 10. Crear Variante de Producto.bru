meta {
  name: K159 - AUSENTE_presentationName - 10. Crear Variante de Producto
  type: http
  seq: 191
}

post {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/products/{{productId}}/variants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "sku": "CHEESE-IND-01",
  "priceAmount": 18.5,
  "priceCurrency": "PEN",
  "tracksInventory": true,
  "attributes": []
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
