meta {
  name: K136 - UUID_INVALIDO_productId - 07. Obtener Producto por ID
  type: http
  seq: 171
}

get {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/products/invalid-uuid
  body: none
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
