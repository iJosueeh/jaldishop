meta {
  name: K205 - ATTR_NOMBRE_NULO - 12. Actualizar Variante
  type: http
  seq: 235
}

put {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/products/{{productId}}/variants/{{variantId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "presentationName": "Porción Individual Grande",
  "sku": "CHEESE-IND-01",
  "priceAmount": 20.0,
  "priceCurrency": "PEN",
  "tracksInventory": true,
  "status": "ACTIVE",
  "attributes": [
    {
      "name": null,
      "value": "v"
    }
  ]
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
