meta {
  name: M030 - SIN_AUTH - 07. Actualizar Mi Perfil
  type: http
  seq: 310
}

put {
  url: {{baseUrl}}/api/v1/users/me
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "firstName": "{{fixtureFirstName}}",
  "lastName": "{{fixtureLastName}}",
  "phone": "{{fixturePhone}}"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
