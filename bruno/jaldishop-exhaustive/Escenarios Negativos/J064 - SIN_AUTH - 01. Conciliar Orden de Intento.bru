meta {
  name: J064 - SIN_AUTH - 01. Conciliar Orden de Intento
  type: http
  seq: 51
}

post {
  url: {{baseUrl}}/api/v1/admin/payments/attempts/{{attemptId}}/reconcile-order
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
