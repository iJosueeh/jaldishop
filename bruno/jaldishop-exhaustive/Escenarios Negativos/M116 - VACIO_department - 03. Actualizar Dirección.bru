meta {
  name: M116 - VACIO_department - 03. Actualizar Dirección
  type: http
  seq: 392
}

put {
  url: {{baseUrl}}/api/v1/customer/addresses/{{addressId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "alias": "Casa Principal",
  "recipientName": "{{fixtureRecipientName}}",
  "recipientPhone": "{{fixtureRecipientPhone}}",
  "streetAddress": "{{fixtureStreetAddress}}",
  "department": "",
  "province": "Lima",
  "district": "Miraflores",
  "ubigeoCode": "150122",
  "reference": "{{fixtureReference}}",
  "latitude": 0.0,
  "longitude": 0.0,
  "isDefault": true
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
