meta {
  name: K152 - UUID_INVALIDO_storeId - 09. Listar Variantes de Producto
  type: http
  seq: 185
}

get {
  url: {{baseUrl}}/api/v1/merchants/stores/invalid-uuid/products/{{productId}}/variants
  body: none
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
