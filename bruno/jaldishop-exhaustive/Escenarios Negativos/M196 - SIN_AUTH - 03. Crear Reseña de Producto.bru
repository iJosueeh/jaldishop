meta {
  name: M196 - SIN_AUTH - 03. Crear Reseña de Producto
  type: http
  seq: 450
}

post {
  url: {{baseUrl}}/api/v1/customer/products/{{productId}}/reviews
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "rating": 5,
  "comment": "Excelente producto, 100% recomendado"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
