meta {
  name: M207 - UUID_INVALIDO_productId - 04. Actualizar Reseña de Producto
  type: http
  seq: 460
}

put {
  url: {{baseUrl}}/api/v1/customer/products/invalid-uuid/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "rating": 4,
  "comment": "Muy bueno pero tardó un poco"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
