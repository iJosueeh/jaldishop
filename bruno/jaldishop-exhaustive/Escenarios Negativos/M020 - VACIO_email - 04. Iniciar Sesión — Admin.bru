meta {
  name: M020 - VACIO_email - 04. Iniciar Sesión — Admin
  type: http
  seq: 303
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "email": "",
  "password": "{{adminPassword}}"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
