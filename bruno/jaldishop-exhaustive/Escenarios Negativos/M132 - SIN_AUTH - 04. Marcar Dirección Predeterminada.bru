meta {
  name: M132 - SIN_AUTH - 04. Marcar Dirección Predeterminada
  type: http
  seq: 407
}

patch {
  url: {{baseUrl}}/api/v1/customer/addresses/{{addressId}}/default
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
