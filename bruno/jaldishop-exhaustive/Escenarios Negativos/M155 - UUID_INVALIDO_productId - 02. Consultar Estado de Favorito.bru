meta {
  name: M155 - UUID_INVALIDO_productId - 02. Consultar Estado de Favorito
  type: http
  seq: 422
}

get {
  url: {{baseUrl}}/api/v1/customer/favorites/products/invalid-uuid/status
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
