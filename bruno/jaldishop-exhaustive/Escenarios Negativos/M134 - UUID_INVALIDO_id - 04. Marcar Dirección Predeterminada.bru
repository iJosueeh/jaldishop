meta {
  name: M134 - UUID_INVALIDO_id - 04. Marcar Dirección Predeterminada
  type: http
  seq: 409
}

patch {
  url: {{baseUrl}}/api/v1/customer/addresses/invalid-uuid/default
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
