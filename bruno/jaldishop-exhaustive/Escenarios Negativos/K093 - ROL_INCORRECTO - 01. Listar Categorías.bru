meta {
  name: K093 - ROL_INCORRECTO - 01. Listar Categorías
  type: http
  seq: 134
}

get {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/categories
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Accept: application/json
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
