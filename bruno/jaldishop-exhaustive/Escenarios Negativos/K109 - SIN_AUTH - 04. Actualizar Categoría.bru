meta {
  name: K109 - SIN_AUTH - 04. Actualizar Categoría
  type: http
  seq: 147
}

put {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/categories/{{categoryId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "name": "Postres y Dulces",
  "description": "Nueva descripción",
  "status": "ACTIVE"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
