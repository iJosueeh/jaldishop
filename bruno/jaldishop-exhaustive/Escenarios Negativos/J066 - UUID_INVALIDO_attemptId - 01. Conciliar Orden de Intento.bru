meta {
  name: J066 - UUID_INVALIDO_attemptId - 01. Conciliar Orden de Intento
  type: http
  seq: 53
}

post {
  url: {{baseUrl}}/api/v1/admin/payments/attempts/invalid-uuid/reconcile-order
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Accept: application/json
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
