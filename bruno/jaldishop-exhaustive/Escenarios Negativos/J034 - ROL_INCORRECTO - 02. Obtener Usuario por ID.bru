meta {
  name: J034 - ROL_INCORRECTO - 02. Obtener Usuario por ID
  type: http
  seq: 29
}

get {
  url: {{baseUrl}}/api/v1/admin/users/{{userId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
