meta {
  name: M167 - SIN_AUTH - 02. Agregar Ítem al Carrito
  type: http
  seq: 430
}

post {
  url: {{baseUrl}}/api/v1/cart/items
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "storeId": "{{storeId}}",
  "variantId": "{{variantId}}",
  "quantity": 2
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
