meta {
  name: K255 - UUID_INVALIDO_id - 08. Actualizar Excepción
  type: http
  seq: 272
}

put {
  url: {{baseUrl}}/api/v1/capacity-exceptions/invalid-uuid
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "serviceDate": "{{serviceDate}}",
  "startTime": "{{startTime}}",
  "endTime": "{{endTime}}",
  "exceptionCapacity": 0,
  "reason": "Cerrado por Navidad"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
