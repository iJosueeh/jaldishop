meta {
  name: K112 - UUID_INVALIDO_categoryId - 04. Actualizar Categoría
  type: http
  seq: 150
}

put {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/categories/invalid-uuid
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "name": "Postres y Dulces",
  "description": "Nueva descripción",
  "status": "ACTIVE"
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
