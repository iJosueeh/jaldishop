meta {
  name: K112 - UUID_INVALIDO_categoryId - 04. Actualizar Categoría
  type: http
  seq: 150
}

put {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/categories/invalid-uuid
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "name": "Postres y Dulces",
  "description": "Nueva descripción",
  "status": "ACTIVE"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
