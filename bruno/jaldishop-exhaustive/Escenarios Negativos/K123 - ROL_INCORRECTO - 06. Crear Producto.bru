meta {
  name: K123 - ROL_INCORRECTO - 06. Crear Producto
  type: http
  seq: 159
}

post {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "categoryId": "{{categoryId}}",
  "name": "Torta Tres Leches",
  "slug": "tres-leches",
  "description": "Deliciosa torta",
  "imageUrl": "{{fixtureImageUrl}}"
}
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
