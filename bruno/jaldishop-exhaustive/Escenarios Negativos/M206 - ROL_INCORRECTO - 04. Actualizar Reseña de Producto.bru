meta {
  name: M206 - ROL_INCORRECTO - 04. Actualizar Reseña de Producto
  type: http
  seq: 459
}

put {
  url: {{baseUrl}}/api/v1/customer/products/{{productId}}/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantOnlyToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "rating": 4,
  "comment": "Muy bueno pero tardó un poco"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
