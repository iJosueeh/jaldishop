meta {
  name: K164 - AUSENTE_priceAmount - 10. Crear Variante de Producto
  type: http
  seq: 196
}

post {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/products/{{productId}}/variants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "presentationName": "Porción Individual",
  "sku": "CHEESE-IND-01",
  "priceCurrency": "PEN",
  "tracksInventory": true,
  "attributes": []
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
