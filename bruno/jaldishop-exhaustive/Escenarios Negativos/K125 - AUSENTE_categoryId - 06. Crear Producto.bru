meta {
  name: K125 - AUSENTE_categoryId - 06. Crear Producto
  type: http
  seq: 161
}

post {
  url: {{baseUrl}}/api/v1/merchants/stores/{{storeId}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "name": "Torta Tres Leches",
  "slug": "tres-leches",
  "description": "Deliciosa torta",
  "imageUrl": "{{fixtureImageUrl}}"
}
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
