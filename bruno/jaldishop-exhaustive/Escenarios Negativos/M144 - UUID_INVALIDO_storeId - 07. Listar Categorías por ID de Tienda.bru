meta {
  name: M144 - UUID_INVALIDO_storeId - 07. Listar Categorías por ID de Tienda
  type: http
  seq: 415
}

get {
  url: {{baseUrl}}/api/v1/stores/invalid-uuid/categories
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  const url = req.getUrl();
  if (!/^http:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?\//.test(url)) {
    throw new Error("Por seguridad local, baseUrl debe apuntar a localhost / 127.0.0.1");
  }
}

tests {
  test("HTTP esperado", function() { expect(res.getStatus()).to.equal(200); });
}
